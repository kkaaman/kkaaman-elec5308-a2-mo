{
  "schema_version": 1,
  "name": "mapless_v1",
  "description": "Four cameras, one roof LiDAR, three radars, consumer GNSS, IMU and a wheel-encoder speedometer. Within the CARLA Leaderboard 2.0 SENSORS-track limits. Mounts are relative to the CARLA actor origin of vehicle.tesla.model3 (+x forward, +y left, +z up).",
  "sensors": [
    {"type": "camera", "name": "front", "width": 1280, "height": 720, "fov_deg": 90.0,
     "mount": {"x_m": 1.5, "y_m": 0.0, "z_m": 2.0}},
    {"type": "camera", "name": "front_left", "width": 640, "height": 360, "fov_deg": 100.0,
     "mount": {"x_m": 1.2, "y_m": 0.5, "z_m": 1.9, "yaw_deg": 60.0}},
    {"type": "camera", "name": "front_right", "width": 640, "height": 360, "fov_deg": 100.0,
     "mount": {"x_m": 1.2, "y_m": -0.5, "z_m": 1.9, "yaw_deg": -60.0}},
    {"type": "camera", "name": "rear", "width": 640, "height": 360, "fov_deg": 100.0,
     "mount": {"x_m": -2.2, "y_m": 0.0, "z_m": 1.7, "yaw_deg": 180.0}},
    {"type": "lidar", "name": "roof", "channels": 32, "range_m": 70.0, "rotation_frequency_hz": 20.0,
     "points_per_second": 640000, "upper_fov_deg": 10.0, "lower_fov_deg": -25.0,
     "mount": {"x_m": 0.0, "y_m": 0.0, "z_m": 2.4}},
    {"type": "radar", "name": "radar_front", "horizontal_fov_deg": 30.0, "vertical_fov_deg": 10.0,
     "range_m": 100.0, "points_per_second": 1500,
     "mount": {"x_m": 2.4, "y_m": 0.0, "z_m": 0.7}},
    {"type": "radar", "name": "radar_rear_left", "horizontal_fov_deg": 90.0, "vertical_fov_deg": 10.0,
     "range_m": 60.0, "points_per_second": 1500,
     "mount": {"x_m": -2.3, "y_m": 0.9, "z_m": 0.7, "yaw_deg": 150.0}},
    {"type": "radar", "name": "radar_rear_right", "horizontal_fov_deg": 90.0, "vertical_fov_deg": 10.0,
     "range_m": 60.0, "points_per_second": 1500,
     "mount": {"x_m": -2.3, "y_m": -0.9, "z_m": 0.7, "yaw_deg": -150.0}},
    {"type": "gnss", "name": "gnss", "period_s": 0.2, "white_m": 0.5, "bias_sigma_m": 1.0,
     "mount": {"x_m": -1.38641, "y_m": 0.0, "z_m": 1.6}},
    {"type": "imu", "name": "imu", "gyro_white_rps": 0.005, "gyro_bias_sigma_rps": 0.002,
     "accel_white_mps2": 0.05, "compass_white_rad": 0.02,
     "mount": {"x_m": -1.38641, "y_m": 0.0, "z_m": 1.6}},
    {"type": "speedometer", "name": "wheel_speed", "white_mps": 0.05, "scale_sigma": 0.01}
  ]
}
