{
  "schema_version": 1,
  "name": "mapless_v2",
  "description": "Rig v2 (plan v2.1, section 4). Compared with v1: radar 6,000 points/s with a 60 x 15 deg front radar and 15 deg vertical rear radars, mounted just outside the bumpers; LiDAR at 2.2 m, -30..+10 deg, 60 m, nominal drop-off 0.20; side and rear cameras at 800x450. Radar density and front FOV are an experiment: vary them with --set (for example radar_front.points_per_second=3000). Mounts are relative to the CARLA actor origin of vehicle.tesla.model3 (+x forward, +y left, +z up).",
  "sensors": [
    {"type": "camera", "name": "front", "width": 1280, "height": 720, "fov_deg": 90.0,
     "mount": {"x_m": 1.5, "y_m": 0.0, "z_m": 2.0}},
    {"type": "camera", "name": "front_left", "width": 800, "height": 450, "fov_deg": 100.0,
     "mount": {"x_m": 1.2, "y_m": 0.5, "z_m": 1.9, "yaw_deg": 60.0}},
    {"type": "camera", "name": "front_right", "width": 800, "height": 450, "fov_deg": 100.0,
     "mount": {"x_m": 1.2, "y_m": -0.5, "z_m": 1.9, "yaw_deg": -60.0}},
    {"type": "camera", "name": "rear", "width": 800, "height": 450, "fov_deg": 100.0,
     "mount": {"x_m": -2.2, "y_m": 0.0, "z_m": 1.7, "yaw_deg": 180.0}},
    {"type": "lidar", "name": "roof", "channels": 32, "range_m": 60.0, "rotation_frequency_hz": 20.0,
     "points_per_second": 640000, "upper_fov_deg": 10.0, "lower_fov_deg": -30.0,
     "noise_stddev_m": 0.02, "dropoff_general_rate": 0.20, "dropoff_intensity_limit": 0.8,
     "dropoff_zero_intensity": 0.4,
     "mount": {"x_m": 0.0, "y_m": 0.0, "z_m": 2.2}},
    {"type": "radar", "name": "radar_front", "horizontal_fov_deg": 60.0, "vertical_fov_deg": 15.0,
     "range_m": 80.0, "points_per_second": 6000,
     "mount": {"x_m": 2.5, "y_m": 0.0, "z_m": 0.7}},
    {"type": "radar", "name": "radar_rear_left", "horizontal_fov_deg": 90.0, "vertical_fov_deg": 15.0,
     "range_m": 60.0, "points_per_second": 6000,
     "mount": {"x_m": -2.45, "y_m": 0.85, "z_m": 0.7, "yaw_deg": 150.0}},
    {"type": "radar", "name": "radar_rear_right", "horizontal_fov_deg": 90.0, "vertical_fov_deg": 15.0,
     "range_m": 60.0, "points_per_second": 6000,
     "mount": {"x_m": -2.45, "y_m": -0.85, "z_m": 0.7, "yaw_deg": -150.0}},
    {"type": "gnss", "name": "gnss", "period_s": 0.2, "white_m": 0.5, "bias_sigma_m": 1.0, "north_sign": -1,
     "mount": {"x_m": -1.38641, "y_m": 0.0, "z_m": 1.6}},
    {"type": "imu", "name": "imu", "gyro_white_rps": 0.005, "gyro_bias_sigma_rps": 0.002,
     "accel_white_mps2": 0.05, "compass_white_rad": 0.02,
     "mount": {"x_m": -1.38641, "y_m": 0.0, "z_m": 1.6}},
    {"type": "speedometer", "name": "wheel_speed", "white_mps": 0.05, "scale_sigma": 0.01}
  ]
}
