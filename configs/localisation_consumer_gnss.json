    "wheel_white_mps": 0.05,
    "wheel_scale_sigma": 0.01
  },
  "filter": {
    "gnss_sigma_m": 1.2,
    "wheel_sigma_mps": 0.08,
    "wheel_scale_sigma": 0.015,
    "gyro_sigma_rps": 0.01,
    "bias_walk_rps_per_sqrt_s": 0.0002,
    "initial_yaw_sigma_rad": 0.0873,
    "initial_bias_sigma_rps": 0.005
  }
}
